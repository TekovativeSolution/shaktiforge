<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_lot_no_passed_form_view_inherited" model="ir.ui.view">
        <field name="name">mrp.production.form.view</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
              <xpath expr="//button[@name='button_unbuild']" position="after">
                <button name="action_assign_lot_no" type="object" invisible="state != 'confirmed'" string="Assign Lot No." class="oe_highlight"/>
            </xpath>
        </field>
    </record>
</odoo>