<odoo>

    <record id="view_stock_move_form_inherit_heat_no" model="ir.ui.view">
        <field name="name">stock.move.form.inherit.heat.no</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">

             <xpath expr="//label[@for='product_uom_qty']/following-sibling::div[@class='o_row']"
                   position="after">
                <field name="heat_no"/>
                <field name="no_of_lots" invisible="picking_code != 'incoming'"/>
                <button name="generate_dynamic_lot" string="Generate Lot" type="object" class="oe_link"
                        invisible="picking_code != 'incoming'"/>
            </xpath>

        </field>
    </record>

</odoo>