<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="0">
        <record id="module_category_qc_status" model="ir.module.category">
            <field name="name">QC Status</field>
            <field name="sequence">1</field>
        </record>

        <record id="group_qc_status_user" model="res.groups">
            <field name="name">Transfer User</field>
            <field name="category_id" ref="grn_shakti.module_category_qc_status"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">the user only show transfer to QC state receipt.</field>
        </record>

        <record id="rule_stock_picking_type_qc_user" model="ir.rule">
            <field name="name">QC User: Receipts Operation Type Only</field>
            <field name="model_id" ref="stock.model_stock_picking_type"/>
            <field name="groups" eval="[(4, ref('grn_shakti.group_qc_status_user'))]"/>
            <field name="domain_force">[('code', '=', 'incoming')]</field>
        </record>
    </data>
</odoo>