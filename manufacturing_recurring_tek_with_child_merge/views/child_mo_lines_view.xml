<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="parent_mo_lines_tree_inherit" model="ir.ui.view">
        <field name="name">parent.mo.lines.tree.view</field>
        <field name="model">parent.mo.lines</field>
        <field name="arch" type="xml">
            <tree>
                <field name="parent_mo_line_id"/>
                <field name="child_mo_id"/>
            </tree>
        </field>
    </record>

    <record id="parent_mo_lines_search" model="ir.ui.view">
        <field name="name">parent.mo.lines.search</field>
        <field name="model">parent.mo.lines</field>
        <field name="arch" type="xml">
            <search string="Search parent MO Lines">
                <group expand="0" string="Group By">
                    <filter name="group_parent_mo_line"
                          string="parent MO"
                          context="{'group_by': 'parent_mo_line_id'}"
                          />
                </group>
            </search>
        </field>
    </record>

    <record id="parent_mo_lines_action" model="ir.actions.act_window">
        <field name="name">Parent MO Lines</field>
        <field name="res_model">parent.mo.lines</field>
        <field name="view_id" ref="parent_mo_lines_tree_inherit"/>
        <field name="context">{'search_default_group_parent_mo_line':1}</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="menu_parent_mo_lines"
          name="Parent MO wise Child MO"
          parent="mrp.menu_mrp_manufacturing"
          action="parent_mo_lines_action"
          sequence="6"
        />
</odoo>
