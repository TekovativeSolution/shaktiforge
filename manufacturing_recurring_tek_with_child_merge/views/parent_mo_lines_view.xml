<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="child_mo_lines_tree_inherit" model="ir.ui.view">
        <field name="name">child.mo.lines.tree.view</field>
        <field name="model">child.mo.lines</field>
        <field name="arch" type="xml">
            <tree>
                <field name="child_mo_line_id"/>
                <field name="parent_mo_id"/>
                <field name="qty"/>
            </tree>
        </field>
    </record>

    <record id="child_mo_lines_search" model="ir.ui.view">
        <field name="name">child.mo.lines.search</field>
        <field name="model">child.mo.lines</field>
        <field name="arch" type="xml">
            <search string="Search Child MO Lines">
                <group expand="0" string="Group By">
                    <filter name="group_child_mo_line"
                          string="Child MO"
                          context="{'group_by': 'child_mo_line_id'}"
                          />
                </group>
            </search>
        </field>
    </record>

    <record id="child_mo_lines_action" model="ir.actions.act_window">
        <field name="name">Child MO Lines</field>
        <field name="res_model">child.mo.lines</field>
        <field name="view_id" ref="child_mo_lines_tree_inherit"/>
        <field name="context">{'search_default_group_child_mo_line':1}</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="menu_child_mo_lines"
          name="Child MO wise Parent MO"
          parent="mrp.menu_mrp_manufacturing"
          action="child_mo_lines_action"
          sequence="5"
        />
</odoo>
