<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <record id="quality_point_inherit_form_view" model="ir.ui.view">
        <field name="name">quality.point.inherit.form.view</field>
        <field name="model">quality.point</field>
        <field name="inherit_id" ref="quality.quality_point_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='failure_location_ids']" position="after">
                 <field name="picking_type_id" />
            </xpath>
        </field>
     </record>


</odoo>