<?xml version="1.0"?>
<odoo>
    <data>
        <record id="sale_order_inherit_view" model="ir.ui.view">
	        <field name="name">sale.order.form</field>
	        <field name="model">sale.order</field>
	        <field name="inherit_id" ref="sale.view_order_form"/>
	        <field name="arch" type="xml">
                <xpath expr="//button[@name='payment_action_void']" position="after">
					  <button string="Import" name="action_import_sale_order_line" type="object" class="oe_highlight"/>
				</xpath>
                <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='product_id']" position="before">
                    <field name="product_domain" column_invisible="True"/>
                    <field name="product_customer_code_domain" column_invisible="True"/>
                    <field name="product_code_id" domain="product_customer_code_domain" />
                    <field name="product_name_id" />

                </xpath>
                <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='product_template_id']" position="replace">
                    <field name="product_template_id" string="Product"  readonly="not product_updatable" required="not display_type" context="{'partner_id': parent.partner_id, 'quantity': product_uom_qty }" domain="product_domain" widget="sol_product_many2one" placeholder="Type to find a product..."/>
                </xpath>

            </field>
        </record>

            <record id="sale_order_line_import_shakti_view_tree" model="ir.ui.view">
            <field name="name">sale.order.line.tree.view</field>
            <field name="model">sale.order.line</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="order_id"/>
                    <field name="product_code_id"/>
                    <field name="product_name_id"/>
                    <field name="product_id"/>
                    <field name="name"/>
                    <field name="product_uom_qty"/>
                    <field name="price_unit"/>
                    <field name="tax_id"/>
                    <field name="price_subtotal"/>
                </tree>
            </field>
        </record>

        <record id="sale_order_line_shakti_import_action" model="ir.actions.act_window">
            <field name="name">Sale Order Line Import</field>
            <field name="res_model">sale.order.line</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="sale_order_line_import_shakti_view_tree"/>
        </record>
    </data>
</odoo>