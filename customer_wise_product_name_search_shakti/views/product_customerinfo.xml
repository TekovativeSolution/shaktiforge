<?xml version="1.0"?>
<odoo>
    <data>
        <record id="product_customerinfo_tree_view" model="ir.ui.view">
            <field name="name">product.customerinfotree</field>
            <field name="model">product.customerinfo</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="partner_id"/>
                    <field name="product_id"/>
                    <field name="product_name_id"/>
                    <field name="product_code_id"/>
                    <field name="description"/>
                    <field name="price"/>
                    <field name="currency_id"/>
                </tree>
            </field>
        </record>

        <record id="product_customerinfo_form_view" model="ir.ui.view">
            <field name="name">product.customerinfo.form.view</field>
            <field name="model">product.customerinfo</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="partner_id"/>
                                <field name="product_name_id"/>
                                <field name="product_code_id"/>
                                <field name="description"/>
                                <field name="price"/>
                                <field name="currency_id"/>
                                <field name="product_id" />
                                <field name="product_tmpl_id" />
                            </group>
                            <group>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="product_customerinfo_action_view" model="ir.actions.act_window">
            <field name="name">Product CustomerInfo</field>
            <field name="res_model">product.customerinfo</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="product_customerinfo_menu"
                  action="product_customerinfo_action_view"
                  name="Customer Pricelist"
                  sequence="10"
                  parent='sale.menu_sale_config'/>
    </data>
</odoo>